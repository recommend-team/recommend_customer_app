# Everything prefixed VITE_ is baked into the bundle at build time and is PUBLIC.
# Never put a secret here.

# REST base, including the version prefix.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Socket.IO origin. The /chat namespace is appended by the client.
VITE_SOCKET_URL=http://localhost:4000

# Optional — error tracking is skipped when absent.
VITE_SENTRY_DSN=
